; 虎扑 Quantumult X rewrite snippet — converted from Egern hupu.yaml (fixed goblin body version)
; Subscribe via [rewrite_remote]; the goblin.hupu.com DIRECT rule lives in quanx-hupu-filter.snippet ([filter_remote]).
; Respond '{}' entries become reject-dict; the goblin getOther respond and all response_jq
; entries are handled by quanx-hupu.js (script-echo-response / script-response-body branches).
hostname = games.mobileapi.hupu.com, fairy.mobileapi.hupu.com, bbs.mobileapi.hupu.com, goblin.hupu.com, match-api.hupu.com, *.hupu.com
^https?://goblin\.hupu\.com/\d+/[\d.]+/interfaceAd/getOther/ url script-echo-response https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-hupu.js
^https://fairy\.mobileapi\.hupu\.com/gallery/getmod2 url reject-dict
^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/search/v2/hintkeylist url reject-dict
^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bbsallapi/users/browse/topics url reject-dict
^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bbsallapi/tag/v1/heatTag url reject-dict
^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bbsrankapi/bff/v1/rating/list url reject-dict
^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bplapi/user/v1/more url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-hupu.js
^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/buffer/hotList url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-hupu.js
^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/topics/\d url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-hupu.js
^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bbsallapi/topics/topicSquareDetail url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-hupu.js
^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bbsallapi/lego/data url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-hupu.js
^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bplbffapi/device/v1/nav/content url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-hupu.js
^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bbsallapi/tab/cardModule url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-hupu.js
