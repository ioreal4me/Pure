#!name = Spotify 去广告 + Premium 补丁 (QuanX combined test)
#!author = Combined sources: app2smile (proto patch), devchristian1337 (ad filters), Reukix (rejects)
#!desc = 先登录 Spotify 再启用，然后重启 App；音质不能设为超高 (Very High)。resolver/nebula 的 proto 补丁为实验分支。
hostname = spclient.wg.spotify.com, *spclient.spotify.com
^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:user-customization-service\/v1\/customize|nebula\/v\d+\/configuration\/attributes|remote-config-resolver\/v\d+\/configuration)\/?(?:\?[^#]*)?$ url script-request-header https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-spotify.js
^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)\/?(?:\?[^#]*)?$ url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-spotify.js
^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:nebula\/v\d+\/configuration\/attributes|remote-config-resolver\/v\d+\/configuration)\/?(?:\?[^#]*)?$ url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-spotify.js
^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/casita\/v\d+\/home(?:\/[^?#]*)?(?:\?[^#]*)?$ url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-spotify.js
^https:\/\/(?:spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(?::443)?)\/browsita\/v.\/browse(?:[^?#]*)?(?:\?[^#]*)?$ url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-spotify.js
^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/scrollsita\/v[0-9]+\/scroll\/spotify:[^?#]+(?:\?[^#]*)?$ url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/test/quanx-spotify.js
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon url reject-dict
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pam-view-service\/ url reject
^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:ads\/|ad-logic\/|[^?#]*\/ad-on-app-open|premium-marketing\/upsellOffer) url reject
^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service url reject-200
^https:\/\/.*37i9dQZF1EYkqdzj48dyYq url reject
