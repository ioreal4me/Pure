^https?://weibointl\.api\.weibo\.cn/portal\.php\?a=search_topic& url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/Quantumult%20X/Script/quanx-weibo.js
^https?://weibointl\.api\.weibo\.cn/portal\.php\?a=user_center& url script-response-body https://raw.githubusercontent.com/ioreal4me/iOS/main/Quantumult%20X/Script/quanx-weibo.js
